{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "pch-default",
            "hidden": true,
            "cacheVariables": {
                "SFFDN_ENABLE_PCH": "ON"
            }
        },
        {
            "name": "gcc-ninja",
            "displayName": "GCC-Ninja",
            "inherits": "pch-default",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/gcc",
            "cacheVariables": {}
        },
        {
            "name": "llvm-ninja",
            "displayName": "LLVM - Ninja",
            "description": "Build for LLVM",
            "inherits": "pch-default",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/ninja",
            "toolchainFile": "${sourceDir}/cmake/llvm-toolchain.cmake"
        },
        {
            "name": "llvm-tidy",
            "displayName": "LLVM - Ninja with Static Analysis",
            "description": "Build for LLVM with clang-tidy static analysis",
            "inherits": "pch-default",
            "binaryDir": "${sourceDir}/build/llvm-tidy",
            "toolchainFile": "${sourceDir}/cmake/llvm-toolchain.cmake",
            "cacheVariables": {
                "SFFDN_ENABLE_STATIC_ANALYSIS": "ON"
            }
        },
        {
            "name": "llvm-fea",
            "displayName": "LLVM - Function Effect Analysis",
            "description": "Build with strict Clang Function Effect Analysis diagnostics",
            "inherits": "pch-default",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/llvm-fea",
            "toolchainFile": "${sourceDir}/cmake/llvm-toolchain.cmake",
            "cacheVariables": {
                "SFFDN_ENABLE_FUNCTION_EFFECTS": "ON",
                "SFFDN_TREAT_FUNCTION_EFFECTS_AS_ERRORS": "ON",
                "SFFDN_USE_SANITIZER": "OFF"
            }
        },
        {
            "name": "llvm-rtsan",
            "displayName": "LLVM - RealtimeSanitizer",
            "description": "Build with RealtimeSanitizer and strict Clang Function Effect Analysis",
            "inherits": "pch-default",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/llvm-rtsan",
            "toolchainFile": "${sourceDir}/cmake/llvm-toolchain.cmake",
            "cacheVariables": {
                "SFFDN_USE_RTSAN": "ON",
                "SFFDN_USE_SANITIZER": "OFF",
                "SFFDN_ENABLE_FUNCTION_EFFECTS": "ON",
                "SFFDN_TREAT_FUNCTION_EFFECTS_AS_ERRORS": "ON"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows",
            "description": "Build for Windows",
            "inherits": "pch-default",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build/windows",
            "toolchainFile": "${sourceDir}/cmake/msvc-toolchain.cmake",
            "cacheVariables": {}
        }
    ],
    "buildPresets": [
        {
            "name": "llvm",
            "configurePreset": "llvm-ninja"
        },
        {
            "name": "gcc",
            "configurePreset": "gcc-ninja"
        },
        {
            "name": "llvm-tidy",
            "configurePreset": "llvm-tidy"
        },
        {
            "name": "llvm-fea",
            "configurePreset": "llvm-fea"
        },
        {
            "name": "llvm-rtsan",
            "configurePreset": "llvm-rtsan"
        },
        {
            "name": "windows",
            "configurePreset": "windows"
        }
    ]
}